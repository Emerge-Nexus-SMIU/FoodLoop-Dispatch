DATABASE_URL=postgresql://foodloop:foodloop_local@127.0.0.1:5432/foodloop
APP_ORIGIN=http://localhost:3000
# Local demo only. Set explicitly to allow fixture seed; never enable on a real production database.
ALLOW_DEMO_SEED=true

# Run npm run dev:configure to generate this locally. Use your hosting secret manager in production.
AUTH_ENCRYPTION_KEY=
MAIL_TRANSPORT=file
# Production transactional mail: set transport to resend with a verified sender.
# RESEND_API_KEY=
# MAIL_FROM=
# SUPPORT_EMAIL=  (owner decision pending)
OPERATING_COUNTRY=PK
# Explicit loopback-only fixture login; do not enable on a public deployment.
ALLOW_DEMO_LOGIN=false
